{
  // Preview before going live: a separate Worker, only on its workers.dev address, no custom domain.
  // npx wrangler deploy -c wrangler.preview.jsonc
  "name": "scoutsheet-preview",
  "compatibility_date": "2026-10-12",
  "main": "worker.js",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/stats", "/app-stats", "/img/*.mp4"] },
  "workers_dev": true,
  "preview_urls": false
}
