{
  // Old name kept on purpose: installed FM26 Scout builds link to fm26-scout-site.*.workers.dev for downloads.
  "name": "fm26-scout-site",
  "compatibility_date": "2026-10-12",
  "main": "worker.js",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/stats", "/app-stats", "/img/*.mp4"] },
  "workers_dev": true,  // the old address installed builds link to
  "preview_urls": false,
  "triggers": { "crons": ["17 3 * * *"] },  // deletes app usage counts older than 14 months
  "d1_databases": [{ "binding": "DB", "database_name": "scoutsheet-stats", "database_id": "81b0646c-650b-46d5-9e80-844cc3237b98" }],
  "routes": [{ "pattern": "scoutsheet.fm", "custom_domain": true }, { "pattern": "www.scoutsheet.fm", "custom_domain": true }]
}
